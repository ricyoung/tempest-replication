# API Keys for Tempest Pipeline (OPTIONAL if using Ollama evaluator)
# Get your OpenAI API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API key for Claude models
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Use Ollama for evaluation instead of OpenAI (default: true)
USE_OLLAMA_EVALUATOR=true

# Which Ollama model to use for evaluation (default: deepseek-v3.1:671b-cloud)
EVALUATOR_MODEL=deepseek-v3.1:671b-cloud

# Ollama server URL (default: http://localhost:11434)
# For remote Ollama server, uncomment and set your IP:
OLLAMA_BASE_URL=http://10.10.0.202:11434

# Optional: Limit number of behaviors to test (default: 100)
# MAX_BEHAVIORS=100

# Optional: Weights & Biases for training tracking
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=zochi
# WANDB_ENTITY=your_wandb_entity

# Optional: Hugging Face token for model downloads
# HF_TOKEN=your_huggingface_token_here
