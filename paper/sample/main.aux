\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces MTEB medical benchmark performance visualization for CardioEmbed (higher is better). CardioEmbed achieved 0.77 Spearman correlation on BIOSSES (biomedical similarity) and 0.61 NDCG@10 on SciFact (scientific verification). Performance on NFCorpus (0.20 NDCG@10, general medical retrieval) is shown for comparison. Color zones indicate Strong (green, $>$0.6), Moderate (orange, 0.3--0.6), and areas requiring improvement (red, $<$0.3).}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:mteb_heatmap}{{1}{7}{MTEB medical benchmark performance visualization for CardioEmbed (higher is better). CardioEmbed achieved 0.77 Spearman correlation on BIOSSES (biomedical similarity) and 0.61 NDCG@10 on SciFact (scientific verification). Performance on NFCorpus (0.20 NDCG@10, general medical retrieval) is shown for comparison. Color zones indicate Strong (green, $>$0.6), Moderate (orange, 0.3--0.6), and areas requiring improvement (red, $<$0.3)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cardiology retrieval performance comparison across five embedding models (higher is better). CardioEmbed achieves 99.60\% Acc@1, representing +15.94\% improvement over MedTE (SOTA medical model).}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:model_comparison}{{2}{7}{Cardiology retrieval performance comparison across five embedding models (higher is better). CardioEmbed achieves 99.60\% Acc@1, representing +15.94\% improvement over MedTE (SOTA medical model)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Retrieval accuracy at different ranks (higher is better). CardioEmbed (fine‑tuned) achieved 99.6\%--100\% across all ranks, while the base model showed lower accuracy at all rank thresholds.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:accuracy_at_k}{{3}{8}{Retrieval accuracy at different ranks (higher is better). CardioEmbed (fine‑tuned) achieved 99.6\%--100\% across all ranks, while the base model showed lower accuracy at all rank thresholds}{figure.caption.5}{}}
