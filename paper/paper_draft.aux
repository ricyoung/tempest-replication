\@writefile{toc}{\contentsline {section}{\numberline {4}Results}{11}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Overall Attack Success Rates}{11}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Attack success rates by model compared to original TEMPEST results~\cite  {zhou2025tempest}. All models evaluated on 100 JailbreakBench behaviors. Models show a spectrum of vulnerability, from immediate jailbreak (1.0 turns) to sustained resistance (22.7 turns).}}{11}{table.caption.5}\protected@file@percent }
\newlabel{tab:results}{{2}{11}{Attack success rates by model compared to original TEMPEST results~\cite {zhou2025tempest}. All models evaluated on 100 JailbreakBench behaviors. Models show a spectrum of vulnerability, from immediate jailbreak (1.0 turns) to sustained resistance (22.7 turns)}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Scale vs.\ safety: model size does not predict adversarial robustness. (a) Total parameters vs.\ ASR shows no correlation ($r = -0.12$, n.s.) across nine models (excluding thinking mode variant). (b) Active parameters vs.\ ASR similarly shows no relationship. Filled circles indicate dense architecture (Gemma3 only); open triangles indicate mixture-of-experts. The smallest model (12B Gemma3) and largest MoE models (675B Mistral Large 3, 1T Kimi K2) all achieve $\geq $97\% ASR in standard mode. Dotted line indicates Zhou and Arel (2025) baseline.}}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scale}{{4}{12}{Scale vs.\ safety: model size does not predict adversarial robustness. (a) Total parameters vs.\ ASR shows no correlation ($r = -0.12$, n.s.) across nine models (excluding thinking mode variant). (b) Active parameters vs.\ ASR similarly shows no relationship. Filled circles indicate dense architecture (Gemma3 only); open triangles indicate mixture-of-experts. The smallest model (12B Gemma3) and largest MoE models (675B Mistral Large 3, 1T Kimi K2) all achieve $\geq $97\% ASR in standard mode. Dotted line indicates Zhou and Arel (2025) baseline}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Attack success rates by harm category across models. Heatmap shows ASR (\%) for each model-category combination. Highly vulnerable models (Gemma3, Mistral, DeepSeek) show uniform 100\% ASR across categories, while more resistant models exhibit category-specific variation (e.g., MiniMax M2: 10\% Violence vs. 70\% Privacy).}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:heatmap}{{5}{13}{Attack success rates by harm category across models. Heatmap shows ASR (\%) for each model-category combination. Highly vulnerable models (Gemma3, Mistral, DeepSeek) show uniform 100\% ASR across categories, while more resistant models exhibit category-specific variation (e.g., MiniMax M2: 10\% Violence vs. 70\% Privacy)}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Computational cost of attacking each model. The scatter plot reveals an inverse relationship between attack success rate and total API queries required per 100 behaviors. Highly vulnerable models (red, upper-left) require fewer than 2,500 queries because TEMPEST's early termination stops exploration upon successful jailbreak. Resistant models (green, lower-right) require 13,000--24,000 queries as the tree search exhaustively explores branches before finding successful attack paths. This 10--27$\times $ cost multiplier demonstrates that while resistance rarely prevents eventual jailbreak, it substantially increases computational cost for attackers---a practical deterrent even when absolute prevention fails.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cost}{{6}{14}{Computational cost of attacking each model. The scatter plot reveals an inverse relationship between attack success rate and total API queries required per 100 behaviors. Highly vulnerable models (red, upper-left) require fewer than 2,500 queries because TEMPEST's early termination stops exploration upon successful jailbreak. Resistant models (green, lower-right) require 13,000--24,000 queries as the tree search exhaustively explores branches before finding successful attack paths. This 10--27$\times $ cost multiplier demonstrates that while resistance rarely prevents eventual jailbreak, it substantially increases computational cost for attackers---a practical deterrent even when absolute prevention fails}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Query and Branching Budget Transparency}{14}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Stored conversation messages per model. These counts reflect only the final successful attack paths retained for analysis; total API queries including all explored branches exceeded 97,000 (see Table~\ref {tab:api_queries}).}}{15}{table.caption.9}\protected@file@percent }
\newlabel{tab:queries}{{3}{15}{Stored conversation messages per model. These counts reflect only the final successful attack paths retained for analysis; total API queries including all explored branches exceeded 97,000 (see Table~\ref {tab:api_queries})}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Total API queries per model including all explored branches. Target queries are calls to the model under attack; attacker queries are calls to the attack generation model (DeepSeek V3.1); evaluator queries assess response harmfulness. The 27$\times $ difference between most and least vulnerable models demonstrates the computational cost of attacking resistant systems.}}{15}{table.caption.10}\protected@file@percent }
\newlabel{tab:api_queries}{{4}{15}{Total API queries per model including all explored branches. Target queries are calls to the model under attack; attacker queries are calls to the attack generation model (DeepSeek V3.1); evaluator queries assess response harmfulness. The 27$\times $ difference between most and least vulnerable models demonstrates the computational cost of attacking resistant systems}{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Vulnerability Spectrum: Turn Distribution Analysis}{15}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Thinking Mode Comparison}{16}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Thinking mode comparison: Kimi K2 variants under identical TEMPEST attacks on all 100 behaviors.}}{16}{table.caption.11}\protected@file@percent }
\newlabel{tab:thinking}{{5}{16}{Thinking mode comparison: Kimi K2 variants under identical TEMPEST attacks on all 100 behaviors}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Thinking mode comparison for Kimi K2. (a) Attack success rate reduced by 55 percentage points when thinking mode was enabled (97\% $\rightarrow $ 42\%). (b) Average turns to jailbreak increased 10.8$\times $ (1.6 $\rightarrow $ 17.2 turns), indicating substantially greater computational cost for successful attacks. While thinking mode provides meaningful protection, 42\% of attacks still succeed, indicating residual vulnerability even with extended reasoning.}}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:thinking}{{7}{16}{Thinking mode comparison for Kimi K2. (a) Attack success rate reduced by 55 percentage points when thinking mode was enabled (97\% $\rightarrow $ 42\%). (b) Average turns to jailbreak increased 10.8$\times $ (1.6 $\rightarrow $ 17.2 turns), indicating substantially greater computational cost for successful attacks. While thinking mode provides meaningful protection, 42\% of attacks still succeed, indicating residual vulnerability even with extended reasoning}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Attack progression curves showing cumulative successful jailbreaks by conversation turn. Immediately vulnerable models (Mistral, DeepSeek, Gemma3) reach near-maximum success within 1--2 turns, exhibiting ``brittle'' defenses that fail immediately. Resistant models (GPT-OSS variants, MiniMax, Kimi K2 Thinking) show gradual accumulation requiring 10+ turns, demonstrating ``persistent'' defenses that eventually yield but impose substantial cost on attackers.}}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:progression}{{8}{17}{Attack progression curves showing cumulative successful jailbreaks by conversation turn. Immediately vulnerable models (Mistral, DeepSeek, Gemma3) reach near-maximum success within 1--2 turns, exhibiting ``brittle'' defenses that fail immediately. Resistant models (GPT-OSS variants, MiniMax, Kimi K2 Thinking) show gradual accumulation requiring 10+ turns, demonstrating ``persistent'' defenses that eventually yield but impose substantial cost on attackers}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Attack Strategy Effectiveness}{17}{subsection.4.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Category-Level Analysis}{17}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Behavior difficulty distribution across all models. The funnel visualization shows that most behaviors are universally exploitable: 79\% succeeded against 8+ models, while only 3\% showed meaningful resistance (succeeding against $\leq $5 models). No behavior resisted all models entirely.}}{19}{figure.caption.14}\protected@file@percent }
\newlabel{fig:funnel}{{9}{19}{Behavior difficulty distribution across all models. The funnel visualization shows that most behaviors are universally exploitable: 79\% succeeded against 8+ models, while only 3\% showed meaningful resistance (succeeding against $\leq $5 models). No behavior resisted all models entirely}{figure.caption.14}{}}
